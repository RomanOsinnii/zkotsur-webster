# For direct URL building when CLIENT_BASE_URL is not set.
# Set 8080 for docker-published frontend, keep 5173 for local Vite dev.
CLIENT_PORT=8080
SERVER_PORT=3000
POSTGRES_PORT=5432
PORT=3000
DB_SYNCHRONIZE=ture
POSTGRES_HOST=localhost
POSTGRES_DB=webster
POSTGRES_USER=webster
POSTGRES_PASSWORD=webster
POSTGRES_SSL=false
JWT_SECRET=change-me-for-production
JWT_EXPIRES_IN=7d
# Preferred absolute frontend URL for links in verification/reset emails.
CLIENT_BASE_URL=http://webster.underv0lt.com:8080

# Email verification delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional deployment notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
